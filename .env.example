# 复制为 .env 后填写；不要提交真实密钥。
base_url=
api_key=
model=

# 必填：本地开发使用的 PostgreSQL 连接地址。
# 密码中的 @、/ 等特殊字符须做 URL 编码。
database_url=
# 示例：postgresql+psycopg://postgres:URL编码后的密码@127.0.0.1:5432/liuhen

# 可选：独立裁判模型。留空时使用上面的 Agent 模型。
# judge_base_url=
# judge_api_key=
# judge_model=

# 登录。本地用 http 访问前端时把 cookie_secure 设为 false；线上（HTTPS）保持 true。
# cookie_secure=false
# 允许发起写请求的页面来源，逗号分隔；默认是本地 Vite 开发地址。
# allowed_origins=http://127.0.0.1:5173,http://localhost:5173
# 普通用户每日对话轮数默认上限（1–1000，默认 50）；管理员不受限制，可在管理后台为单个用户调整。
# default_daily_chat_limit=50

# 发信（注册、绑定邮箱、找回密码的验证码）。QQ 邮箱：在"设置 → 账号"开启 SMTP 服务并生成授权码。
# 未配置时获取验证码返回 503，注册无法完成。
# smtp_host=smtp.qq.com
# smtp_port=465
# smtp_username=完整的发件邮箱地址
# smtp_password=SMTP 授权码（不是 QQ 密码）
